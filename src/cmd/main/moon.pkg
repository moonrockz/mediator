import {
  "moonrockz/mediator/codegen",
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
}

pkgtype(kind: "executable")

options(
  "pre-build": [
    {
      "command": ":embed -i $input -o $output --text --name moon_mod",
      "input": "../../../moon.mod",
      "output": "moon_mod_resource.mbt",
    },
  ],
)
